# 이 파일을 .env.deploy로 복사한 뒤 사용자의 OpenAI 키와 모델을 입력합니다.
# 실제 키와 비밀번호는 Git·Docker 이미지에 포함하지 않습니다.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
LLM_PROVIDER=openai

# 아래 DB 값은 생략하면 Compose의 로컬 기본값을 사용합니다.
# 운영 환경에서는 반드시 강한 값으로 덮어쓰세요.
# POSTGRES_DB=ai_mafia
# POSTGRES_MIGRATION_USER=migration_user
# POSTGRES_MIGRATION_PASSWORD=change-this-migration-password
# POSTGRES_APP_USER=app_user
# POSTGRES_APP_PASSWORD=change-this-app-password

FRONTEND_HOST_PORT=18501
BACKEND_HOST_PORT=18000

# 컨테이너 내부 서비스명은 Compose가 주입하므로 사용자가 수정하지 않습니다.
AI_MAFIA_STORAGE_MODE=isolated
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_SECONDS=30
