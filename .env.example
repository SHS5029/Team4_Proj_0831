# 이 파일은 여러 프로세스의 설정 키를 모은 예시 카탈로그입니다. 운영에서 한
# 프로세스가 통째로 로드하지 말고 README의 프로세스별 allowlist만 주입하세요.
# Backend runtime용 PostgreSQL 연결 문자열입니다. DML 최소 권한 계정을 사용하고,
# 비밀번호를 포함한 실제 값은 승인된 비밀 저장소에만 보관하세요.
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/Team4_Proj
# 목표 migration runner가 읽을 DDL 계정입니다. 현재 runner는 아직 DATABASE_URL만
# 읽으므로 README의 격리 주입 절차를 따릅니다. Backend runtime에는 제공하지 마세요.
DATABASE_MIGRATION_URL=postgresql://migration_user:change-me@localhost:5432/Team4_Proj
DATABASE_NAME=Team4_Proj

# 현재 legacy identity 코드에서만 쓰는 Frontend→Backend 요청 서명 키입니다.
# UUID-only WU-F1·WU-B1 전환 뒤 제거합니다.
INTERNAL_API_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
INTERNAL_API_MAX_AGE_SECONDS=300

# --- 이하 AI 마피아 MVP(docs/개발상세플랜/AI_MAFIA_MASTER_PLAN.md) 설정 ---
# REDIS_URL, LLM Provider와 MAFIA_MCP_URL은 현재 scaffold도 읽습니다. keyring,
# 관리자와 새 내부 보안 계약은 canonical WU에서 연결할 목표 설정입니다. 실제
# 비밀값은 승인된 비밀 저장소나 해당 컴포넌트만 읽는 파일에만 보관하세요.

# Redis: 게임 lock, 공개 cache, event stream과 내부 HMAC nonce에 사용합니다.
REDIS_URL=redis://localhost:6379/0

# 게임 seed와 snapshot keyring은 저장소 밖의 권한 제한 JSON 파일에 둡니다.
# 이 예시 파일에는 실제 base64url key를 적지 마세요.
GAME_STATE_KEYRING_FILE=/secure/path/game-state-keyring.json
GAME_STATE_ACTIVE_KEY_ID=development-key-v1

# UUID-only read-only 관리자 API allowlist입니다. 비어 있으면 관리자 접근을 모두
# 거부합니다. 실제 UUID 목록은 비밀 설정으로 주입하고 공개 인터넷에서 사용하지 마세요.
ADMIN_USER_IDS=

# 한 번에 하나만 선택합니다. dummy, local, openai 또는 gemini를 지원하며 외부 호출이
# 없는 현재 기본값 dummy를 예시에 사용합니다. 자동 Provider failover는 없습니다.
LLM_PROVIDER=dummy
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=local-model
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# 현재 config.py와 scaffold proposal은 legacy LLM_TIMEOUT_SECONDS,
# LLM_MAX_OUTPUT_TOKENS, GAME_MAX_TOTAL_TOKENS와 비용 단가의 내장 기본값을 아직
# 읽습니다. 이 항목은 canonical MVP 설정이 아니므로 예시에 값을 두지 않으며 WU-B6에서
# 코드와 함께 제거합니다. Agent 중단 복구는 고정 worker lease를 사용합니다.

# 게임 컨텍스트 MCP의 전체 Streamable HTTP endpoint입니다. client가 `/mcp`를
# 다시 붙이지 않습니다.
MAFIA_MCP_URL=http://127.0.0.1:8100/mcp
# Backend Agent Manager가 MCP session bootstrap을 인증하는 별도 키입니다.
# 운영에서는 검증된 HTTPS 연결과 함께 사용하며 다른 내부 서명 키를 재사용하지 마세요.
MCP_SERVER_AUTH_SECRET=REPLACE_WITH_ANOTHER_32_CHAR_RANDOM_VALUE
# 다음 두 값은 Backend MCP client의 transport 검증 설정입니다.
MCP_REQUIRE_TLS=false
MCP_TLS_CA_FILE=/path/to/ca-bundle.pem

# MCP 서버가 Backend 내부 Engine API를 호출할 때 쓰는 서명 키와 주소입니다.
# 보안 경계 분리를 위해 legacy INTERNAL_API_SECRET과 반드시 다른 32자 이상의
# 무작위 값을 사용하세요. 계약은 docs/개발상세플랜/AI_MAFIA_API_SPEC.md 8장입니다.
ENGINE_INTERNAL_API_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHAR_RANDOM_VALUE
ENGINE_API_URL=http://127.0.0.1:8000
