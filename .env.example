# 이 파일은 여러 프로세스의 설정 키를 모은 예시 카탈로그입니다. 운영에서 한
# 프로세스가 통째로 로드하지 말고 README의 프로세스별 allowlist만 주입하세요.
# Backend runtime용 PostgreSQL 연결 문자열입니다. DML 최소 권한 계정을 사용하고,
# 비밀번호를 포함한 실제 값은 승인된 비밀 저장소에만 보관하세요.
# 실제 원격 PostgreSQL 검증 시 우선 사용하는 DSN. 실제 비밀번호는 기록하지 않는다.
TEAM_DATABASE_URL=postgresql://runtime_user:change-me@remote-host:4000/Team4_Proj
# TEAM_DATABASE_URL이 없을 때만 사용하는 로컬 테스트용 fallback
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/Team4_Proj
# 목표 migration runner가 읽을 DDL 계정입니다. 현재 runner는 아직 DATABASE_URL만
# 읽으므로 README의 격리 주입 절차를 따릅니다. Backend runtime에는 제공하지 마세요.
DATABASE_MIGRATION_URL=postgresql://migration_user:change-me@localhost:5432/Team4_Proj
DATABASE_NAME=Team4_Proj
# --- 이하 AI 마피아 MVP(docs/개발상세플랜/AI_MAFIA_MASTER_PLAN.md) 설정 ---
# REDIS_URL과 LLM Provider 설정은 Backend가 읽습니다. FastMCP process 설정은 아래
# BACKEND_API_URL과 MCP_LISTEN_*로 분리합니다. 실제 비밀값은 승인된 비밀 저장소나
# 해당 컴포넌트만 읽는 파일에만 보관하세요.

# Redis: 게임 lock, 공개 cache와 event stream 보조 계층에 사용합니다.
REDIS_URL=redis://localhost:6379/0

# 게임 seed와 snapshot keyring은 저장소 밖의 권한 제한 JSON 파일에 둡니다.
# 이 예시 파일에는 실제 base64url key를 적지 마세요.
GAME_STATE_KEYRING_FILE=/secure/path/game-state-keyring.json
GAME_STATE_ACTIVE_KEY_ID=development-key-v1

# UUID-only read-only 관리자 API allowlist입니다. 비어 있으면 관리자 접근을 모두
# 거부합니다. 실제 UUID 목록은 비밀 설정으로 주입하고 공개 인터넷에서 사용하지 마세요.
ADMIN_USER_IDS=

# 한 번에 하나만 선택합니다. dummy, local, openai 또는 gemini를 지원하며 외부 호출이
# 없는 현재 기본값 dummy를 예시에 사용합니다. 자동 Provider failover는 없습니다.
LLM_PROVIDER=dummy
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3.2:latest
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Backend 중앙 AI worker가 호출할 FastMCP 서버 주소입니다.
MCP_SERVER_URL=http://127.0.0.1:8100
# 브라우저 SSE fetch를 허용할 Front origin 목록입니다. 쉼표로 구분합니다.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8501,http://127.0.0.1:8502,http://localhost:8501,http://localhost:8502

# 현재 config.py와 scaffold proposal은 legacy LLM_TIMEOUT_SECONDS,
# LLM_MAX_OUTPUT_TOKENS, GAME_MAX_TOTAL_TOKENS와 비용 단가의 내장 기본값을 아직
# 읽습니다. 이 항목은 canonical MVP 설정이 아니므로 예시에 값을 두지 않으며 WU-B6에서
# 코드와 함께 제거합니다. Agent 중단 복구는 고정 worker lease를 사용합니다.

# 최소 FastMCP process가 Backend에 접근할 주소입니다.
BACKEND_API_URL=http://127.0.0.1:8000
MCP_LISTEN_HOST=127.0.0.1
MCP_LISTEN_PORT=8100
