# PostgreSQL 연결 문자열입니다. 비밀번호를 포함한 실제 값은 .env에만 보관하세요.
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/Team4_Proj
DATABASE_NAME=Team4_Proj

# Frontend 서버와 Backend 서버가 공유하는 내부 요청 서명 키입니다.
# 운영에서는 32자 이상의 독립적인 무작위 값을 사용하고 두 서버에 같은 값을 설정하세요.
INTERNAL_API_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
INTERNAL_API_MAX_AGE_SECONDS=300

# --- 이하 AI 마피아 MVP(docs/AI_MAFIA_MVP_FINAL_PLAN.md)용 예약 항목 ---
# 아직 코드가 연결되지 않은 예약 설정입니다. 실제 키 값은 .env에만 보관하세요.

# Redis: 게임 lock, idempotency, runtime cache, event stream에 사용합니다.
REDIS_URL=redis://localhost:6379/0

# LLM 공급자 선택: openai 또는 gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Agent run 제한: LLM 호출 timeout과 게임당 token 상한
LLM_TIMEOUT_SECONDS=30
GAME_MAX_TOKENS_PER_RUN=2000

# 게임 컨텍스트 MCP 서버(mcp_server/mcp_1) 주소
MAFIA_MCP_URL=http://127.0.0.1:8100

# MCP 서버가 Backend 내부 Engine API를 호출할 때 쓰는 서명 키와 주소입니다.
# 보안 경계 분리를 위해 Frontend용 INTERNAL_API_SECRET과 반드시 다른
# 32자 이상의 무작위 값을 사용하세요. (docs/AI_MAFIA_IMPLEMENTATION_PLAN.md 5장)
ENGINE_INTERNAL_API_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHAR_RANDOM_VALUE
ENGINE_API_URL=http://127.0.0.1:8000
