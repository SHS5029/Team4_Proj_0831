# PostgreSQL 연결 문자열입니다. 비밀번호를 포함한 실제 값은 .env에만 보관하세요.
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/Team4_Proj
DATABASE_NAME=Team4_Proj

# Frontend 서버와 Backend 서버가 공유하는 내부 요청 서명 키입니다.
# 운영에서는 32자 이상의 독립적인 무작위 값을 사용하고 두 서버에 같은 값을 설정하세요.
INTERNAL_API_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
INTERNAL_API_MAX_AGE_SECONDS=300

# --- 이하 AI 마피아 MVP(docs/AI_MAFIA_MVP_FINAL_PLAN.md)용 설정 ---
# API key와 실제 운영 단가는 .env에만 보관하며 저장소에 커밋하지 마세요.

# Redis: 게임 lock, idempotency, runtime cache, event stream에 사용합니다.
REDIS_URL=redis://localhost:6379/0

# LLM 공급자 선택: dummy, local, openai 또는 gemini
LLM_PROVIDER=dummy
# local은 OpenAI 호환 API를 제공하는 로컬 서버 주소를 사용합니다.
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=local-model
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Agent run과 게임 단위 강제 한도
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=400
GAME_MAX_TOTAL_TOKENS=60000
GAME_COST_WARNING_USD=1.00
# 원격 provider 사용 시 선택 모델의 현재 백만 token당 가격으로 바꾸세요. 0이면 시작을 거부합니다.
LLM_INPUT_COST_PER_MILLION_USD=0.00
LLM_OUTPUT_COST_PER_MILLION_USD=0.00

# 역할 배정 seed 암호화 키입니다. 실제 값은 32바이트 키의 base64 문자열이어야 합니다.
GAME_SEED_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# 저장 데이터 보존 기본값
PAUSED_GAME_RETENTION_DAYS=30
FINISHED_GAME_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=180

# 게임 컨텍스트 MCP 서버(mcp_server/mcp_1) 주소
MAFIA_MCP_URL=http://127.0.0.1:8010/mcp
# MCP가 필터링된 AgentContext를 조회할 Backend 내부 주소와 전용 HMAC 키
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
MCP_INTERNAL_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
