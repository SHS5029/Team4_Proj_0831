# 이 파일은 여러 프로세스의 설정 키를 모은 예시 카탈로그입니다. 운영에서 한
# 프로세스가 통째로 로드하지 말고 README의 프로세스별 allowlist만 주입하세요.
# Backend runtime용 PostgreSQL 연결 문자열입니다. DML 최소 권한 계정을 사용하고,
# 비밀번호를 포함한 실제 값은 승인된 비밀 저장소에만 보관하세요.
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/Team4_Proj
# MCP 인프라 담당자가 migration 실행 때만 사용하는 DDL 계정입니다.
# Backend runtime 프로세스에는 이 값을 제공하지 마세요.
DATABASE_MIGRATION_URL=postgresql://migration_user:change-me@localhost:5432/Team4_Proj
DATABASE_NAME=Team4_Proj

# Frontend 서버와 Backend 서버가 공유하는 내부 요청 서명 키입니다.
# 운영에서는 32자 이상의 독립적인 무작위 값을 사용하고 두 서버에 같은 값을 설정하세요.
INTERNAL_API_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
INTERNAL_API_MAX_AGE_SECONDS=300

# --- 이하 AI 마피아 MVP(docs/플랜/AI_MAFIA_MVP_FINAL_PLAN.md)용 예약 항목 ---
# 아직 코드가 연결되지 않은 예약 설정입니다. 실제 비밀값은 승인된 비밀 저장소나
# 해당 컴포넌트만 읽는 권한 제한 로컬 파일에만 보관하세요.

# Redis: 게임 lock, idempotency, runtime cache, event stream에 사용합니다.
REDIS_URL=redis://localhost:6379/0

# LLM 공급자 선택: openai 또는 gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Agent run 제한: LLM 호출 상한, 외부 작업 총예산, commit·network 예약과 token 상한
LLM_TIMEOUT_SECONDS=15
MCP_TIMEOUT_SECONDS=3
AGENT_EXTERNAL_CALL_BUDGET_SECONDS=16
AGENT_COMMIT_NETWORK_RESERVE_SECONDS=3
GAME_MAX_TOKENS_PER_RUN=2000

# 게임 컨텍스트 MCP의 전체 Streamable HTTP endpoint입니다. client가 `/mcp`를
# 다시 붙이지 않습니다.
MAFIA_MCP_URL=http://127.0.0.1:8100/mcp
# Backend Agent Manager가 MCP session bootstrap을 인증하는 별도 키입니다.
# 운영에서는 검증된 HTTPS 연결과 함께 사용하며 다른 내부 서명 키를 재사용하지 마세요.
MCP_SERVER_AUTH_SECRET=REPLACE_WITH_ANOTHER_32_CHAR_RANDOM_VALUE
MCP_REQUIRE_TLS=false
MCP_TLS_CA_FILE=/path/to/ca-bundle.pem
MCP_CLOCK_SYNC_MAX_RTT_SECONDS=2
MCP_AUDIT_OUTBOX_MAX_RECORDS=1000

# MCP 서버가 Backend 내부 Engine API를 호출할 때 쓰는 서명 키와 주소입니다.
# 보안 경계 분리를 위해 Frontend용 INTERNAL_API_SECRET과 반드시 다른
# 32자 이상의 무작위 값을 사용하세요. (docs/개발상세플랜/AI_MAFIA_IMPLEMENTATION_PLAN.md 5장)
ENGINE_INTERNAL_API_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHAR_RANDOM_VALUE
ENGINE_API_URL=http://127.0.0.1:8000
